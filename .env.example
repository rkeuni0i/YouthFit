# YouthFit AI Environment Variables Template
# 실제 민감한 키 값은 .env 파일에만 저장하고, 이 파일(.env.example)에는 템플릿만 유지합니다.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 온통청년 OpenAPI Key
ONTONG_API_KEY=your_ontong_api_key_here

# PostgreSQL Database URL (Supabase 또는 로컬 PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@your_db_host:5432/postgres

# Google OAuth Client ID (선택사항)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
